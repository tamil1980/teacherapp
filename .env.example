APP_NAME=EduBook
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Kolkata
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database -----------------------------------------------------------
# Local XAMPP MariaDB is configured on port 3307 (see D:\XAMP\mysql\bin\my.ini).
# The EduBook project uses its own `edubook` database and never touches any
# other schema (for example the hospital management `hms` database).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=edubook
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="support@edubook.test"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# --- EduBook platform configuration -------------------------------------
PLATFORM_NAME=EduBook
PLATFORM_CURRENCY=INR
PLATFORM_TIMEZONE=Asia/Kolkata

EDUBOOK_SLOT_GRANULARITY_MINUTES=30
EDUBOOK_DEFAULT_SESSION_MINUTES=60
EDUBOOK_HOLD_TIMEOUT_MINUTES=15
EDUBOOK_MAX_SESSION_MINUTES=240
EDUBOOK_CANCELLATION_WINDOW_HOURS=24
EDUBOOK_CANCELLATION_FEE_PERCENT=0
EDUBOOK_RESCHEDULE_WINDOW_HOURS=12
EDUBOOK_MIN_BOOKING_NOTICE_HOURS=2
EDUBOOK_DEFAULT_TRAVEL_CHARGE=0
EDUBOOK_SUPPORT_PHONE=18001234567
EDUBOOK_SUPPORT_EMAIL=support@edubook.test

# --- Razorpay (India) ---------------------------------------------------
# Sandbox keys from https://dashboard.razorpay.com/app/keys
# Leave blank to use the built-in mock gateway (safe for local development).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_MODE=sandbox

# --- Online meeting provider -------------------------------------------
# manual | google_meet | zoom
MEETING_PROVIDER=manual
MEETING_API_KEY=
MEETING_API_SECRET=
